# Copy the parts you need. Backend: apps/backend/apps/backend/.env
# Storefront: apps/storefront/.env.local

# --- Medusa backend -------------------------------------------------------
DATABASE_URL=postgresql://kmfoods:kmfoods@localhost:5432/kmfoods
JWT_SECRET=change-me
COOKIE_SECRET=change-me
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:3000,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Owner-approved Pakistani number in international form. Empty disables the
# WhatsApp link (the pending order is still created).
WHATSAPP_BUSINESS_NUMBER=

# --- Storefront -----------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# --- End-to-end tests (optional) -----------------------------------------
E2E_BASE_URL=http://localhost:3000
E2E_BACKEND_URL=http://localhost:9000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Docker Compose locals ------------------------------------------------
POSTGRES_USER=kmfoods
POSTGRES_PASSWORD=kmfoods
POSTGRES_DB=kmfoods
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_USER=kmfoods
MINIO_PASSWORD=kmfoods-secret
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9001
